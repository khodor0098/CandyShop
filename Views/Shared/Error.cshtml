@model CandyShop.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card shadow-sm mt-4">
            <div class="card-body text-center">
                <h1 class="h3">@(Model.StatusCode.HasValue ? $"Error {Model.StatusCode}" : "Error")</h1>
                <p class="text-muted">@Model.Message</p>
                @if (Model.ShowRequestId)
                {
                    <p class="small text-muted mb-3">
                        Reference: <code>@Model.RequestId</code>
                    </p>
                }
                <a class="btn btn-primary" asp-controller="Sales" asp-action="Index">Back to Sales</a>
            </div>
        </div>
    </div>
</div>
